{
  "name": "@charter-agreement-protocol/verifier",
  "version": "0.7.0",
  "description": "Independent TypeScript verifier for the Charter Agreement Protocol (CAP) — byte-exact, offline re-verification of signed charter evidence. CAP verifies; it never authorizes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "cap-verifier": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "conformance",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "self-checks": "node --experimental-strip-types --no-warnings self-checks.ts",
    "test": "npm run build && node --test --experimental-strip-types --no-warnings verifier.test.ts api.test.ts parity.test.ts presign.test.ts signing-corpus.test.ts workshop.test.ts ed25519.test.ts",
    "conformance": "node --experimental-strip-types --no-warnings cli.ts",
    "check:ed25519": "node --experimental-strip-types --no-warnings check-ed25519.ts",
    "bench:ed25519": "node --experimental-strip-types --no-warnings bench-ed25519.ts",
    "prepack": "npm run build",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "build:site": "node web/build.mjs"
  },
  "devDependencies": {
    "@charter-agreement-protocol/signer": "^0.2.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.0.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baselabs/charter_agreement_protocol_typescript.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
